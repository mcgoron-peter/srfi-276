(define (flremquo* n d)
  (let-values (((r q) (flremquo n d)))
    (values r (modulo q 8))))

;; Some of these tests come from the SRFI 144 test suite.
;; SPDX-FileCopyrightText: 2017 Will Clinger, 2026 Peter McGoron
;; SPDX-License-Identifier: MIT

(define (test-flremquo)
  (test-group "flremquo"
       (test-values (flremquo* +0.0 1.0) '(+0.0 0))
       (for-each (lambda (numerator denominator)
		   (let-values (((r q) (flremquo* numerator
						  denominator)))
		     (test-assert (flnan? r))
		     (test-assert (exact-integer? q))))
		 '(1.0 1.0 +inf.0 -inf.0)
		 '(+0.0 -0.0 1.0 1.0))

       (for-each (lambda (numerator)
		   (let-values (((r q) (flremquo* numerator +inf.0)))
		     (test-equal r numerator)
		     (test-assert (zero? q)))
		   (let-values (((r q) (flremquo* numerator -inf.0)))
		     (test-equal r numerator)
		     (test-assert (zero? q))))
		 '(-1.0 0.0 1.0))

       ;; 2.0/4.0 = 0.5, rounded to even, is zero.
       (test-values (flremquo* (flonum 2.0) (flonum 4.0))
             (list (flonum 2.0) 0))

       ;; 3.0/4.0 = 0.75, rounded, is 1. The remainder is -1.
       (test-values (flremquo* (flonum 3.0) (flonum 4.0))
             (list (flonum -1.0) 1))

       (test-values (flremquo* (flonum 15.875) (flonum 0.5))
             (list (flonum -0.125) 0))
       (test-values (flremquo* (flonum 16.000) (flonum 0.5))
             (list (flonum +0.000) 0))
       (test-values (flremquo* (flonum 16.125) (flonum 0.5))
             (list (flonum +0.125) 0))
       (test-values (flremquo* (flonum 16.250) (flonum 0.5))
             (list (flonum +0.250) 0))

       (test-values (flremquo* (flonum 16.875) (flonum 0.5))
             (list (flonum -0.125) 2))
       (test-values (flremquo* (flonum 17.000) (flonum 0.5))
             (list (flonum +0.000) 2))
       (test-values (flremquo* (flonum 17.125) (flonum 0.5))
             (list (flonum +0.125) 2))
       (test-values (flremquo* (flonum 17.250) (flonum 0.5))
             (list (flonum +0.250) 2))

       (test-values (flremquo* (flonum 17.875) (flonum 0.5))
             (list (flonum -0.125) 4))
       (test-values (flremquo* (flonum 18.000) (flonum 0.5))
             (list (flonum +0.000) 4))
       (test-values (flremquo* (flonum 18.125) (flonum 0.5))
             (list (flonum +0.125) 4))
       (test-values (flremquo* (flonum 18.250) (flonum 0.5))
             (list (flonum +0.250) 4))

       (test-values (flremquo* (flonum 18.875) (flonum 0.5))
             (list (flonum -0.125) 6))
       (test-values (flremquo* (flonum 19.000) (flonum 0.5))
             (list (flonum +0.000) 6))
       (test-values (flremquo* (flonum 19.125) (flonum 0.5))
             (list (flonum +0.125) 6))
       (test-values (flremquo* (flonum 19.250) (flonum 0.5))
             (list (flonum +0.250) 6))

       (test-values (flremquo* (flonum 15.375) (flonum 0.5))
             (list (flonum -0.125) 7))
       (test-values (flremquo* (flonum 16.500) (flonum 0.5))
             (list (flonum +0.000) 1))
       (test-values (flremquo* (flonum 16.625) (flonum 0.5))
             (list (flonum +0.125) 1))
       (test-values (flremquo* (flonum 16.750) (flonum 0.5))
             (list (flonum -0.250) 2))

       (test-values (flremquo* (flonum 16.375) (flonum 0.5))
             (list (flonum -0.125) 1))
       (test-values (flremquo* (flonum 17.500) (flonum 0.5))
             (list (flonum +0.000) 3))
       (test-values (flremquo* (flonum 17.625) (flonum 0.5))
             (list (flonum +0.125) 3))
       (test-values (flremquo* (flonum 17.750) (flonum 0.5))
             (list (flonum -0.250) 4))

       (test-values (flremquo* (flonum 17.375) (flonum 0.5))
             (list (flonum -0.125) 3))
       (test-values (flremquo* (flonum 18.500) (flonum 0.5))
             (list (flonum +0.000) 5))
       (test-values (flremquo* (flonum 18.625) (flonum 0.5))
             (list (flonum +0.125) 5))
       (test-values (flremquo* (flonum 38.750) (flonum 0.5))
             (list (flonum -0.250) 6))

       (test-values (flremquo* (flonum 18.375) (flonum 0.5))
             (list (flonum -0.125) 5))
       (test-values (flremquo* (flonum 19.500) (flonum 0.5))
             (list (flonum +0.000) 7))
       (test-values (flremquo* (flonum 19.625) (flonum 0.5))
             (list (flonum +0.125) 7))
       (test-values (flremquo* (flonum 19.750) (flonum 0.5))
             (list (flonum -0.250) 0))

       (test-values (flremquo* (flonum 1e300) (flonum 1e-300))
             (list (flonum 4.891554850853602e-301)
                   2))
       (test-values (flremquo* (flonum 1e300) (flonum -1e-300))
             (list (flonum 4.891554850853602e-301)
                   6))
       (test-values (flremquo* (flonum -1e300) (flonum -1e-300))
             (list (flonum -4.891554850853602e-301)
                   2))
       (test-values (flremquo* (flonum -1e300) (flonum 1e-300))
             (list (flonum -4.891554850853602e-301)
                   6))))
